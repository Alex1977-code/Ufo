{
  "name": "aegis-desktop",
  "productName": "AEGIS",
  "version": "1.0.0",
  "description": "AEGIS – Protokoll Erstkontakt (Desktop-Version)",
  "author": "AEGIS",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node build-app.mjs",
    "start": "node build-app.mjs && electron .",
    "dist:win": "node build-app.mjs && electron-builder --win --x64 --publish never",
    "dist:linux": "node build-app.mjs && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "de.aegis.erstkontakt",
    "productName": "AEGIS",
    "copyright": "AEGIS – Protokoll Erstkontakt",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "icon.png", "app/**/*"],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AEGIS – Protokoll Erstkontakt",
      "artifactName": "AEGIS-Setup-${version}.exe"
    },
    "portable": { "artifactName": "AEGIS-Portable-${version}.exe" },
    "linux": { "target": ["dir"], "icon": "icon.png", "category": "Game" }
  }
}
